{
  "info": {
    "name": "UTS PPLOS - Sistem Tiket Event (NIM 2410511081)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8000" },
    { "key": "access_token",  "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "qr_code",       "value": "" }
  ],
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  const d = pm.response.json().data;",
            "  pm.collectionVariables.set('access_token', d.access_token);",
            "  pm.collectionVariables.set('refresh_token', d.refresh_token);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Saif Ali\",\n  \"email\": \"2410511081@gmail.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const d = pm.response.json().data;",
            "  pm.collectionVariables.set('access_token', d.access_token);",
            "  pm.collectionVariables.set('refresh_token', d.refresh_token);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"2410511081@gmail.com\",\n  \"password\": \"password123\"\n}" }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const d = pm.response.json().data;",
            "  pm.collectionVariables.set('access_token', d.access_token);",
            "  pm.collectionVariables.set('refresh_token', d.refresh_token);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/auth/logout",
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" }
          }
        },
        {
          "name": "Get Profile (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/auth/me"
          }
        },
        {
          "name": "GitHub OAuth - Redirect (buka di browser)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/oauth/github"
          }
        }
      ]
    },
    {
      "name": "Event Service",
      "item": [
        {
          "name": "List Events (public + filter + paging)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/events?page=1&per_page=5&category=musik&status=published",
              "host": ["{{base_url}}"],
              "path": ["api", "events"],
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "per_page", "value": "5" },
                { "key": "category", "value": "musik" },
                { "key": "status",   "value": "published" }
              ]
            }
          }
        },
        {
          "name": "Get Event Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/events/1"
          }
        },
        {
          "name": "Get Ticket Categories",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/events/1/categories"
          }
        },
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/events",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Konser Rock Nusantara\",\n  \"description\": \"Konser terbesar tahun ini\",\n  \"location\": \"GBK Jakarta\",\n  \"start_date\": \"2026-08-15 19:00:00\",\n  \"end_date\": \"2026-08-15 23:00:00\",\n  \"category\": \"musik\",\n  \"total_tickets\": 10000\n}" }
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/events/1",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"published\"\n}" }
          }
        },
        {
          "name": "Delete Event",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/events/1"
          }
        },
        {
          "name": "Add Ticket Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/events/1/categories",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Platinum\",\n  \"description\": \"Akses backstage\",\n  \"price\": 2000000,\n  \"quota\": 50\n}" }
          }
        }
      ]
    },
    {
      "name": "Order Service",
      "item": [
        {
          "name": "Checkout Order",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  const tickets = pm.response.json().data.tickets;",
            "  if (tickets && tickets.length > 0) {",
            "    pm.collectionVariables.set('qr_code', tickets[0].qr_code);",
            "  }",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/orders",
            "body": { "mode": "raw", "raw": "{\n  \"ticket_category_id\": 1,\n  \"quantity\": 1\n}" }
          }
        },
        {
          "name": "My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/orders?page=1&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["api", "orders"],
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "per_page", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Order Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/orders/1"
          }
        }
      ]
    },
    {
      "name": "Ticket Service",
      "item": [
        {
          "name": "Validate Ticket (QR Code)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/tickets/validate",
            "body": { "mode": "raw", "raw": "{\n  \"qr_code\": \"{{qr_code}}\"\n}" }
          }
        },
        {
          "name": "Get Ticket Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/tickets/{{qr_code}}"
          }
        },
        {
          "name": "My Validation History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": "{{base_url}}/api/tickets/my"
          }
        },
        {
          "name": "Validate Ticket Already Used (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/tickets/validate",
            "body": { "mode": "raw", "raw": "{\n  \"qr_code\": \"{{qr_code}}\"\n}" }
          }
        },
        {
          "name": "Validate Ticket Not Found (404)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/tickets/validate",
            "body": { "mode": "raw", "raw": "{\n  \"qr_code\": \"TKT-TIDAK-ADA-123\"\n}" }
          }
        }
      ]
    }
  ]
}